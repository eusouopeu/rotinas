<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de rotina: nome + duração à esquerda, botão de iniciar à direita.
     O clique em qualquer parte inicia a rotina (mesmo intent dos atalhos). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EDE7DD"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Rotina" />

        <TextView
            android:id="@+id/widgetMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8A8478"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetPlay"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_play_bg"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:text="▶" />
</LinearLayout>
