<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de metas: até 4 linhas título + progresso, recorrentes "ao dia"
     primeiro e prazos mais próximos preenchendo o que sobrar.
     Sem configuração. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/widget_caneta"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:text="Metas de hoje" />

    <TextView
        android:id="@+id/goalEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_sub"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="Nenhuma meta cadastrada" />

    <LinearLayout
        android:id="@+id/goalRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView android:id="@+id/goalTitle1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/widget_ink" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" android:text="" />
        <TextView android:id="@+id/goalProg1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/widget_sub" android:textSize="13sp"
            android:textStyle="bold" android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/goalRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView android:id="@+id/goalTitle2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/widget_ink" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" android:text="" />
        <TextView android:id="@+id/goalProg2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/widget_sub" android:textSize="13sp"
            android:textStyle="bold" android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/goalRow3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView android:id="@+id/goalTitle3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/widget_ink" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" android:text="" />
        <TextView android:id="@+id/goalProg3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/widget_sub" android:textSize="13sp"
            android:textStyle="bold" android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/goalRow4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView android:id="@+id/goalTitle4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/widget_ink" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" android:text="" />
        <TextView android:id="@+id/goalProg4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/widget_sub" android:textSize="13sp"
            android:textStyle="bold" android:text="" />
    </LinearLayout>
</LinearLayout>
